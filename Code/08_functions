# STRUTTURA IF-ELSE: è una condizione
#distinzione numeri pari e dispari
positivo <- function(x) {                               #su R: positivo(numero incognito)
      if(x>0) {
      "Questo numero è positivo"
      }
      else if(x<0){
      "Questo numero è negativo"}
      else {                              #oppure else(x=0)
      "Zero non è positivo nè negativo"
      }
}

# STRUTTURA FOR detto anche loop o ciclo for
loop <- function() {                                      #su R: loop()
      for(i in 1:50) {       #per i che va da uno a cinquanta, stampa tutti gli i
      print(i)
      }
}

